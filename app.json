{
  "expo": {
    "name": "OFishx",
    "slug": "ofishx",
    "scheme": "ofishx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ofishx.app"
    },
    "android": {
      "package": "com.ofishx.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4FAFA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OFishx uses the camera to photograph a fish for identification.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OFishx lets you choose a fish photo from your gallery for identification.",
          "cameraPermission": "OFishx uses the camera to photograph a fish for identification.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
